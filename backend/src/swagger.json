{
  "openapi": "3.0.0",
  "info": {
    "title": "API Catalogue Produits",
    "version": "1.0.0",
    "description": "API REST pour la gestion et la récupération paginée du catalogue de produits. Développée pour le test technique."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Serveur local"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Endpoints liés aux produits"
    },
    {
      "name": "System",
      "description": "Endpoints de santé et de vérification"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Récupère les produits",
        "description": "Retourne une liste paginée, filtrée et triée des produits disponibles.",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Numéro de la page (commence à 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Nombre de produits par page (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filtre par catégorie",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "shoes",
                "clothing",
                "accessories",
                "bags"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Champ utilisé pour le tri",
            "required": false,
            "schema": {
              "type": "string",
              "default": "createdAt",
              "enum": [
                "price",
                "name",
                "createdAt"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Direction du tri (ascendant ou descendant)",
            "required": false,
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginée des produits récupérée avec succès.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProductsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Vérification de santé",
        "description": "Permet de vérifier que l'API est en cours d'exécution.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "L'API est fonctionnelle.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "ID unique MongoDB du produit",
            "example": "6a13da05f0e8fde4ef9df8a3"
          },
          "name": {
            "type": "string",
            "description": "Nom complet du produit",
            "example": "Urban Drift — Essential Henley (Minimal)"
          },
          "description": {
            "type": "string",
            "description": "Description détaillée",
            "example": "Un(e) essential henley (toile waxée). Pensé pour les trajets quotidiens."
          },
          "price": {
            "type": "number",
            "format": "float",
            "description": "Prix en euros",
            "example": 26.99
          },
          "category": {
            "type": "string",
            "description": "Catégorie du produit",
            "example": "clothing"
          },
          "stock": {
            "type": "integer",
            "description": "Quantité disponible en stock",
            "example": 7
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de création",
            "example": "2026-05-24T05:11:33.172Z"
          }
        }
      },
      "PaginatedProductsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "example": 1
              },
              "limit": {
                "type": "integer",
                "example": 20
              },
              "totalItems": {
                "type": "integer",
                "example": 1250
              },
              "totalPages": {
                "type": "integer",
                "example": 63
              },
              "hasNextPage": {
                "type": "boolean",
                "example": true
              },
              "hasPrevPage": {
                "type": "boolean",
                "example": false
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Internal server error"
              }
            }
          }
        }
      }
    }
  }
}